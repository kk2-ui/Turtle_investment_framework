# Tushare Pro API Token
# Get yours at: https://tushare.pro/register
TUSHARE_TOKEN=your_token_here

# 自定义 Tushare API 地址（代理/镜像服务）
# 留空使用官方 api.tushare.pro
# TUSHARE_API_URL=https://ts.gyzcloud.top/api

# VIP 端点自动升级开关（默认 true）
# 使用官方 Tushare 时保持 true（更高频率限制）
# 使用第三方代理时设为 false（代理通常不支持 _vip 端点）
# VIP_MODE=false

# 路径覆盖（跨机器迁移时可配；不配则默认找仓库内/仓库同级目录）
# TURTLE_DB_PATH=/path/to/Turtle_investment_framework/stock_analysis.db
# TURTLE_OUTPUT_DIR=/path/to/Turtle_investment_framework/output
# TURTLE_DATA_ROOT=/path/to/data-root
# TURTLE_CSMAR_A_PATH=/path/to/cn_financials_panel_raw/上市公司-财务报表年度面板数据.xlsx
# TURTLE_CSMAR_HK_DIR=/path/to/hk_new_financials
# TURTLE_HK_FINANCIALS_DIR=/path/to/hk_financials

# 组合管理：每只个股最高占组合比例（%）
# 所有龟龟策略报告的仓位输出会乘以这个比例
PORTFOLIO_CAP_PCT=5

# Optional: delay (seconds) between Tushare API calls (default: 0.5).
# Set to 0 to disable throttling when using a broker/VIP endpoint with no
# rate limit, which greatly speeds up data collection.
# TUSHARE_RATE_DELAY=0.5
