{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://turtle.local/schemas/company_archetype.schema.json",
  "title": "Turtle Company Archetype",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_id", "registry_version", "registry_fingerprint", "input_sources", "input_fingerprint", "generated_at", "primary_archetype", "secondary_archetypes", "candidate_scores", "matching_evidence", "counterevidence", "conflicts", "required_inputs", "missing_required_inputs", "research_requirements", "classification_limits", "validation"],
  "properties": {
    "schema_version": {"const": "company-archetype.v1"},
    "report_id": {"type": "string", "minLength": 1},
    "registry_version": {"type": "string", "minLength": 1},
    "registry_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input_sources": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "input_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "generated_at": {"type": "string"},
    "primary_archetype": {"$ref": "#/$defs/match"},
    "secondary_archetypes": {"type": "array", "items": {"type": "object"}},
    "candidate_scores": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "matching_evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "counterevidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "conflicts": {"type": "array", "items": {"type": "string"}},
    "required_inputs": {"type": "array", "items": {"type": "object"}},
    "missing_required_inputs": {"type": "array", "items": {"type": "string"}},
    "research_requirements": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "classification_limits": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "validation": {"type": "object"}
  },
  "$defs": {
    "match": {"type": "object", "required": ["archetype_id", "label", "confidence", "basis"], "properties": {"archetype_id": {"type": "string"}, "label": {"type": "string"}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "basis": {"type": "string"}}},
    "evidence": {"type": "object", "required": ["archetype_id", "source_file", "source_path", "observed_value", "matched_rule", "effect"], "properties": {"archetype_id": {"type": "string"}, "source_file": {"type": "string"}, "source_path": {"type": "string"}, "observed_value": {"type": "string"}, "matched_rule": {"type": "string"}, "effect": {"type": "string"}}}
  }
}
