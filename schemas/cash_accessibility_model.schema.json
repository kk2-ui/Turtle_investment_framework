{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://turtle.local/schemas/cash_accessibility_model.schema.json",
  "title": "Turtle canonical cash accessibility model",
  "description": "A source-referenced model that separates legal cash access, realization of existing excess cash, realization of future retained cash, and related-party receivable recovery.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "model_id",
    "company_id",
    "cutoff_at",
    "position_as_of",
    "as_of",
    "currency",
    "unit",
    "input_fact_ids",
    "legal_cash_accessibility",
    "existing_excess_cash_realization",
    "future_retained_cash_realization",
    "related_party_receivable_realization",
    "valuation_destination_ledger",
    "unresolved_facts",
    "economic_conclusion",
    "reader_conclusions"
  ],
  "properties": {
    "schema_version": {"const": "cash-accessibility-model.v1"},
    "model_id": {"type": "string", "minLength": 1},
    "company_id": {"type": "string", "minLength": 1},
    "cutoff_at": {"type": "string", "minLength": 1},
    "position_as_of": {"type": "string", "minLength": 1},
    "as_of": {"type": "string", "minLength": 1},
    "currency": {"type": "string", "minLength": 1},
    "unit": {"type": "string", "minLength": 1},
    "input_fact_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/nonemptyString"}
    },
    "legal_cash_accessibility": {"$ref": "#/$defs/legalCashAccessibility"},
    "existing_excess_cash_realization": {"$ref": "#/$defs/existingExcessCashRealization"},
    "future_retained_cash_realization": {"$ref": "#/$defs/futureRetainedCashRealization"},
    "related_party_receivable_realization": {"$ref": "#/$defs/relatedPartyReceivableRealization"},
    "valuation_destination_ledger": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/destinationLedgerEntry"}
    },
    "unresolved_facts": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/nonemptyString"}
    },
    "economic_conclusion": {"$ref": "#/$defs/nonemptyString"},
    "reader_conclusions": {
      "type": "array",
      "minItems": 4,
      "items": {"$ref": "#/$defs/nonemptyString"}
    }
  },
  "$defs": {
    "nonemptyString": {"type": "string", "minLength": 1},
    "nonnegativeNumber": {"type": "number", "minimum": 0},
    "rate": {"type": "number", "minimum": 0, "maximum": 1},
    "factIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/nonemptyString"}
    },
    "amountRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["low", "base", "high"],
      "properties": {
        "low": {"$ref": "#/$defs/nonnegativeNumber"},
        "base": {"$ref": "#/$defs/nonnegativeNumber"},
        "high": {"$ref": "#/$defs/nonnegativeNumber"}
      }
    },
    "rateRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["low", "base", "high"],
      "properties": {
        "low": {"$ref": "#/$defs/rate"},
        "base": {"$ref": "#/$defs/rate"},
        "high": {"$ref": "#/$defs/rate"}
      }
    },
    "legalCashRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_id",
        "entity_kind",
        "gross_cash",
        "restricted_or_regulatory_cash",
        "operating_liquidity_requirement",
        "excess_cash_before_ownership",
        "ordinary_share_economic_interest",
        "ordinary_share_attributable_before_friction",
        "transfer_tax_friction_rate",
        "transfer_tax_friction_amount",
        "legal_accessible_cash",
        "source_fact_ids"
      ],
      "properties": {
        "entity_id": {"$ref": "#/$defs/nonemptyString"},
        "entity_kind": {
          "enum": [
            "parent",
            "wholly_owned_subsidiary",
            "partially_owned_subsidiary",
            "joint_venture",
            "other"
          ]
        },
        "gross_cash": {"$ref": "#/$defs/nonnegativeNumber"},
        "restricted_or_regulatory_cash": {"$ref": "#/$defs/nonnegativeNumber"},
        "operating_liquidity_requirement": {"$ref": "#/$defs/nonnegativeNumber"},
        "excess_cash_before_ownership": {"$ref": "#/$defs/nonnegativeNumber"},
        "ordinary_share_economic_interest": {"$ref": "#/$defs/rate"},
        "ordinary_share_attributable_before_friction": {"$ref": "#/$defs/nonnegativeNumber"},
        "transfer_tax_friction_rate": {"$ref": "#/$defs/rate"},
        "transfer_tax_friction_amount": {"$ref": "#/$defs/nonnegativeNumber"},
        "legal_accessible_cash": {"$ref": "#/$defs/nonnegativeNumber"},
        "source_fact_ids": {"$ref": "#/$defs/factIds"}
      }
    },
    "legalCashAccessibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "economic_identity",
        "rows",
        "amount_range",
        "adopted_value",
        "adoption_policy",
        "valuation_destination"
      ],
      "properties": {
        "economic_identity": {"$ref": "#/$defs/nonemptyString"},
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/legalCashRow"}
        },
        "amount_range": {"$ref": "#/$defs/amountRange"},
        "adopted_value": {"$ref": "#/$defs/nonnegativeNumber"},
        "adoption_policy": {"const": "computed_legal_ceiling_not_owner_return"},
        "valuation_destination": {"const": "legal_accessibility_ceiling_only"}
      }
    },
    "extraordinaryEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_type",
        "amount",
        "funding_source_identity",
        "eligible_for_existing_excess_cash_calibration",
        "source_fact_ids"
      ],
      "properties": {
        "event_type": {"enum": ["special_dividend", "cancellative_net_buyback"]},
        "amount": {"$ref": "#/$defs/nonnegativeNumber"},
        "funding_source_identity": {
          "enum": ["existing_excess_cash", "future_retained_cash", "debt_funded", "unknown"]
        },
        "eligible_for_existing_excess_cash_calibration": {"type": "boolean"},
        "source_fact_ids": {"$ref": "#/$defs/factIds"}
      }
    },
    "realizationPeriod": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "period_id",
        "comparable",
        "opening_existing_excess_cash",
        "retained_cash_generated",
        "ordinary_dividend",
        "eligible_extraordinary_realization",
        "existing_cash_calibration_qualified",
        "existing_cash_realization_rate",
        "future_retained_cash_calibration_qualified",
        "ordinary_distribution_rate",
        "extraordinary_events",
        "source_fact_ids"
      ],
      "properties": {
        "period_id": {"$ref": "#/$defs/nonemptyString"},
        "period_start": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "period_end": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "comparable": {"type": "boolean"},
        "opening_existing_excess_cash": {"$ref": "#/$defs/nonnegativeNumber"},
        "retained_cash_generated": {"$ref": "#/$defs/nonnegativeNumber"},
        "ordinary_dividend": {"$ref": "#/$defs/nonnegativeNumber"},
        "eligible_extraordinary_realization": {"$ref": "#/$defs/nonnegativeNumber"},
        "existing_cash_calibration_qualified": {"type": "boolean"},
        "existing_cash_realization_rate": {
          "oneOf": [{"$ref": "#/$defs/rate"}, {"type": "null"}]
        },
        "future_retained_cash_calibration_qualified": {"type": "boolean"},
        "ordinary_distribution_rate": {
          "oneOf": [{"$ref": "#/$defs/rate"}, {"type": "null"}]
        },
        "extraordinary_events": {
          "type": "array",
          "items": {"$ref": "#/$defs/extraordinaryEvent"}
        },
        "source_fact_ids": {"$ref": "#/$defs/factIds"}
      },
      "dependentRequired": {
        "period_start": ["period_end"],
        "period_end": ["period_start"]
      }
    },
    "existingExcessCashRealization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "legal_upper_bound",
        "qualifying_period_count",
        "required_period_count",
        "calibration_method",
        "realization_rate_range",
        "amount_range",
        "adopted_realization_rate",
        "adopted_value",
        "adoption_policy",
        "valuation_destination",
        "history"
      ],
      "properties": {
        "legal_upper_bound": {"$ref": "#/$defs/nonnegativeNumber"},
        "qualifying_period_count": {"type": "integer", "minimum": 0},
        "required_period_count": {"const": 3},
        "calibration_method": {
          "enum": ["unqualified_evidence_conservative_bound", "median_of_comparable_periods"]
        },
        "realization_rate_range": {"$ref": "#/$defs/rateRange"},
        "amount_range": {"$ref": "#/$defs/amountRange"},
        "adopted_realization_rate": {"$ref": "#/$defs/rate"},
        "adopted_value": {"$ref": "#/$defs/nonnegativeNumber"},
        "adoption_policy": {
          "enum": [
            "low_end_until_three_comparable_periods",
            "base_median_after_three_comparable_periods"
          ]
        },
        "valuation_destination": {"const": "equity_value_existing_excess_cash"},
        "history": {
          "type": "array",
          "items": {"$ref": "#/$defs/realizationPeriod"}
        }
      }
    },
    "futureRetainedCashRealization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projected_retained_cash",
        "legal_upper_bound_rate",
        "qualifying_period_count",
        "required_period_count",
        "calibration_method",
        "realization_rate_range",
        "amount_range",
        "adopted_realization_rate",
        "adopted_value",
        "adoption_policy",
        "valuation_destination",
        "source_fact_ids"
      ],
      "properties": {
        "projected_retained_cash": {"$ref": "#/$defs/nonnegativeNumber"},
        "legal_upper_bound_rate": {"$ref": "#/$defs/rate"},
        "qualifying_period_count": {"type": "integer", "minimum": 0},
        "required_period_count": {"const": 3},
        "calibration_method": {
          "enum": ["unqualified_evidence_conservative_bound", "median_of_comparable_periods"]
        },
        "realization_rate_range": {"$ref": "#/$defs/rateRange"},
        "amount_range": {"$ref": "#/$defs/amountRange"},
        "adopted_realization_rate": {"$ref": "#/$defs/rate"},
        "adopted_value": {"$ref": "#/$defs/nonnegativeNumber"},
        "adoption_policy": {
          "enum": [
            "low_end_until_three_comparable_periods",
            "base_median_after_three_comparable_periods"
          ]
        },
        "valuation_destination": {"const": "operating_value_future_retained_cash"},
        "source_fact_ids": {"$ref": "#/$defs/factIds"}
      }
    },
    "receivableRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receivable_id",
        "gross_amount",
        "ecl_allowance",
        "post_position_collections",
        "aging_bucket",
        "uncollected_recovery_factor",
        "amount_range",
        "adopted_value",
        "source_fact_ids"
      ],
      "properties": {
        "receivable_id": {"$ref": "#/$defs/nonemptyString"},
        "gross_amount": {"$ref": "#/$defs/nonnegativeNumber"},
        "ecl_allowance": {"$ref": "#/$defs/nonnegativeNumber"},
        "post_position_collections": {"$ref": "#/$defs/nonnegativeNumber"},
        "aging_bucket": {
          "enum": [
            "current",
            "less_than_one_year",
            "one_to_two_years",
            "two_to_three_years",
            "over_three_years",
            "unknown"
          ]
        },
        "uncollected_recovery_factor": {"$ref": "#/$defs/rate"},
        "amount_range": {"$ref": "#/$defs/amountRange"},
        "adopted_value": {"$ref": "#/$defs/nonnegativeNumber"},
        "source_fact_ids": {"$ref": "#/$defs/factIds"}
      }
    },
    "relatedPartyReceivableRealization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rows",
        "gross_receivables",
        "ecl_allowance",
        "post_position_collections",
        "amount_range",
        "adopted_value",
        "adoption_policy",
        "valuation_destination"
      ],
      "properties": {
        "rows": {
          "type": "array",
          "items": {"$ref": "#/$defs/receivableRow"}
        },
        "gross_receivables": {"$ref": "#/$defs/nonnegativeNumber"},
        "ecl_allowance": {"$ref": "#/$defs/nonnegativeNumber"},
        "post_position_collections": {"$ref": "#/$defs/nonnegativeNumber"},
        "amount_range": {"$ref": "#/$defs/amountRange"},
        "adopted_value": {"$ref": "#/$defs/nonnegativeNumber"},
        "adoption_policy": {"const": "collections_only_until_cash_is_received"},
        "valuation_destination": {"const": "equity_value_related_party_receivable"}
      }
    },
    "destinationLedgerEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "valuation_destination", "inclusion_mode", "adopted_value"],
      "properties": {
        "component_id": {
          "enum": [
            "legal_cash_accessibility",
            "existing_excess_cash_realization",
            "future_retained_cash_realization",
            "related_party_receivable_realization"
          ]
        },
        "valuation_destination": {
          "enum": [
            "legal_accessibility_ceiling_only",
            "equity_value_existing_excess_cash",
            "operating_value_future_retained_cash",
            "equity_value_related_party_receivable"
          ]
        },
        "inclusion_mode": {
          "enum": ["BOUND_ONLY", "ADDITIVE_EQUITY_BRIDGE", "OPERATING_VALUE_ADJUSTMENT"]
        },
        "adopted_value": {"$ref": "#/$defs/nonnegativeNumber"}
      }
    }
  }
}
