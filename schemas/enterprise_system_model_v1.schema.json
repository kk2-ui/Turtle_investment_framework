{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://turtle.local/schemas/enterprise_system_model_v1.schema.json",
  "title": "Turtle Canonical EnterpriseSystemModel v1",
  "type": "object",
  "required": [
    "schema_version", "model_id", "company_id", "version", "cutoff_at",
    "method_version", "source_package_id", "responsibility_units", "arenas",
    "operating_variables", "mechanisms", "financial_transmissions",
    "operating_states", "state_changes"
  ],
  "properties": {
    "schema_version": {"const": "enterprise-system-model.v1"},
    "model_id": {"type": "string", "minLength": 1},
    "company_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "cutoff_at": {"type": "string", "format": "date-time"},
    "method_version": {"type": "string", "minLength": 1},
    "source_package_id": {"type": "string", "minLength": 1},
    "responsibility_units": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["unit_id", "unit_type", "parent_unit_id", "accounting_perimeter", "decision_scope", "economic_carrier", "measurement_surface", "legal_entity_ids"],
        "properties": {
          "unit_id": {"type": "string", "minLength": 1},
          "unit_type": {"enum": ["COMPANY", "GROUP", "PARENT", "SUBSIDIARY", "BUSINESS_UNIT"]},
          "parent_unit_id": {"type": ["string", "null"]},
          "accounting_perimeter": {"type": "string", "minLength": 1},
          "decision_scope": {"type": "string", "minLength": 1},
          "economic_carrier": {"type": "string", "minLength": 1},
          "measurement_surface": {"type": "string", "minLength": 1},
          "legal_entity_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": false
      }
    },
    "arenas": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["arena_id", "responsibility_unit_id", "product_or_service_scope", "customer_task", "competition_mechanism", "window", "competitor_or_alternative_refs", "evidence_refs"],
        "properties": {
          "arena_id": {"type": "string", "minLength": 1},
          "responsibility_unit_id": {"type": "string", "minLength": 1},
          "product_or_service_scope": {"type": "string", "minLength": 1},
          "customer_task": {"type": "string", "minLength": 1},
          "competition_mechanism": {"type": "string", "minLength": 1},
          "window": {"type": "string", "minLength": 1},
          "competitor_or_alternative_refs": {"type": "array", "items": {"type": "string"}},
          "evidence_refs": {"$ref": "#/$defs/evidence_refs"}
        },
        "additionalProperties": false
      }
    },
    "operating_variables": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["variable_id", "responsibility_unit_id", "arena_id", "name", "observation_state", "evidence_refs"],
        "properties": {
          "variable_id": {"type": "string", "minLength": 1},
          "responsibility_unit_id": {"type": "string", "minLength": 1},
          "arena_id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "observation_state": {"enum": ["OBSERVED", "INFERRED", "UNKNOWN", "CONTRADICTED"]},
          "evidence_refs": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "mechanisms": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["mechanism_id", "responsibility_unit_id", "arena_id", "description", "reasoning_kind", "from_variable_ids", "to_variable_ids", "management_decision_ids", "evidence_refs"],
        "properties": {
          "mechanism_id": {"type": "string", "minLength": 1},
          "responsibility_unit_id": {"type": "string", "minLength": 1},
          "arena_id": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "reasoning_kind": {"enum": ["OBSERVATION", "INFERENCE"]},
          "from_variable_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "to_variable_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "management_decision_ids": {"type": "array", "items": {"type": "string"}},
          "evidence_refs": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "financial_transmissions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["transmission_id", "mechanism_id", "layer", "direction", "description", "evidence_refs"],
        "properties": {
          "transmission_id": {"type": "string", "minLength": 1},
          "mechanism_id": {"type": "string", "minLength": 1},
          "layer": {"enum": ["NORMAL_EARNINGS", "OWNER_CASH", "PERMANENT_LOSS"]},
          "direction": {"enum": ["IMPROVES", "DETERIORATES", "MIXED", "UNKNOWN", "NONE"]},
          "description": {"type": "string", "minLength": 1},
          "evidence_refs": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "operating_states": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["state_id", "responsibility_unit_id", "observed_at", "variable_states", "evidence_refs"],
        "properties": {
          "state_id": {"type": "string", "minLength": 1},
          "responsibility_unit_id": {"type": "string", "minLength": 1},
          "observed_at": {"type": "string", "format": "date-time"},
          "variable_states": {"type": "object"},
          "evidence_refs": {"$ref": "#/$defs/evidence_refs"}
        },
        "additionalProperties": false
      }
    },
    "state_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["change_id", "from_state_id", "to_state_id", "mechanism_ids", "management_decision_ids", "evidence_refs"],
        "properties": {
          "change_id": {"type": "string", "minLength": 1},
          "from_state_id": {"type": "string", "minLength": 1},
          "to_state_id": {"type": "string", "minLength": 1},
          "mechanism_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "management_decision_ids": {"type": "array", "items": {"type": "string"}},
          "evidence_refs": {"$ref": "#/$defs/evidence_refs"}
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": false
}
