{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gold_report_contract.schema.json",
  "type": "object",
  "required": ["schema_version", "sample_id", "variant_id", "report_sha256", "company_code", "report_period", "information_cutoff", "decisive_questions", "competitive_explanations", "required_evidence_ids", "valuation_roles", "decision_invariants", "known_failure_modes", "review_ids", "human_approval", "fingerprint"],
  "properties": {
    "schema_version": {"const": "gold-report-contract.v1"},
    "sample_id": {"type": "string"},
    "variant_id": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "company_code": {"type": "string"},
    "report_period": {"type": "string"},
    "information_cutoff": {"type": "string"},
    "decisive_questions": {"type": "array", "minItems": 1, "maxItems": 3},
    "competitive_explanations": {"type": "array", "minItems": 1},
    "required_evidence_ids": {"type": "array", "minItems": 1},
    "valuation_roles": {"type": "array", "minItems": 1},
    "decision_invariants": {"type": "array", "minItems": 1},
    "known_failure_modes": {"type": "array"},
    "review_ids": {"type": "array", "minItems": 2},
    "human_approval": {"type": "object", "required": ["approved", "approved_by", "approved_at"]},
    "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
