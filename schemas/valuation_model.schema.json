{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://turtle.local/schemas/valuation_model.schema.json",
  "title": "Turtle V3 Valuation Model Ledger",
  "type": "object",
  "required": ["schema_version", "report_id", "revision", "lifecycle", "change_reason", "company_profile", "models", "synthesis", "freeze"],
  "properties": {
    "schema_version": {"const": "valuation-model-ledger.v1"},
    "report_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "lifecycle": {"enum": ["reviewable", "decision_ready", "monitoring"]},
    "change_reason": {"type": "string", "minLength": 1},
    "company_profile": {
      "type": "object",
      "required": ["business_type", "asset_intensity", "valuation_route", "route_reasoning"],
      "properties": {
        "business_type": {"enum": ["general_operating", "bank", "insurer", "property_developer", "asset_holding", "cyclical", "utility", "pre_revenue_biotech", "conglomerate"]},
        "asset_intensity": {"enum": ["asset_light", "asset_heavy", "mixed"]},
        "valuation_route": {"type": "string"},
        "route_reasoning": {"type": "string"}
      }
    },
    "models": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/model"}},
    "synthesis": {"type": "object"},
    "freeze": {"type": "object", "required": ["frozen", "fingerprint", "frozen_at"]},
    "generated_at": {"type": "string"}
  },
  "$defs": {
    "model": {
      "type": "object",
      "required": ["model_id", "model_type", "role", "status", "chapters", "independence_group_id", "shared_assumption_ids", "applicability", "basis", "assumptions", "result", "source_ids", "decision_entry_ids"],
      "properties": {
        "model_id": {"type": "string", "minLength": 1},
        "model_type": {"enum": ["DCF", "DDM", "EPV", "ASSET_VALUE", "NAV", "SOTP", "RETURN_DECOMPOSITION", "RELATIVE", "RESIDUAL_INCOME", "RNPV"]},
        "role": {"enum": ["primary", "corroborative", "stress", "rejected"]},
        "status": {"enum": ["active", "rejected"]},
        "chapters": {"type": "array", "items": {"type": "integer", "minimum": 0, "maximum": 14}, "minItems": 1},
        "independence_group_id": {"type": "string"},
        "shared_assumption_ids": {"type": "array", "items": {"type": "string"}},
        "applicability": {"type": "object"},
        "basis": {"type": "object"},
        "assumptions": {"type": "object"},
        "result": {"type": "object"},
        "equity_bridge": {"type": "object"},
        "terminal_value": {"type": "object"},
        "sensitivity_tests": {"type": "array", "items": {"type": "object"}},
        "source_ids": {"type": "array", "items": {"type": "string"}},
        "decision_entry_ids": {"type": "array", "items": {"type": "string"}},
        "rejection_reason": {"type": "string"}
      }
    }
  }
}
