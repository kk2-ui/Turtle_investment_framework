{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://turtle.local/schemas/historical_backtest_settlement.schema.json",
  "title": "Turtle Historical Backtest Settlement",
  "type": "object",
  "required": ["schema_version", "settlement_id", "experiment_id", "case_id", "settlement_as_of", "actual_sources", "actual_outcomes", "report_coverage", "model_forecast_error", "investment_return_outcome", "status"],
  "properties": {
    "schema_version": {"const": "historical-backtest-settlement.v1"},
    "settlement_id": {"type": "string", "pattern": "^HBTSET:"},
    "experiment_id": {"type": "string", "pattern": "^HBT:"},
    "case_id": {"type": "string", "pattern": "^HBTCASE:"},
    "settlement_as_of": {"type": "string"},
    "actual_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_id", "source_type", "official", "published_at", "source_version"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "source_type": {"enum": ["ANNUAL_REPORT", "INTERIM_REPORT", "EXCHANGE_ANNOUNCEMENT", "OFFICIAL_STATISTICS", "OFFICIAL_MARKET_DATA", "OTHER_OFFICIAL"]},
          "official": {"const": true},
          "published_at": {"type": "string"},
          "source_version": {"type": "string", "minLength": 1},
          "data_as_of": {"type": ["string", "null"]}
        }
      }
    },
    "actual_outcomes": {
      "type": "object",
      "required": ["currency", "cash_flows", "operating_observations"],
      "properties": {
        "currency": {"type": "string", "minLength": 1},
        "cash_flows": {
          "type": "array",
          "items": {"type": "object", "required": ["date", "amount", "source_ids"], "properties": {"date": {"type": "string"}, "amount": {"type": "number"}, "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}}
        },
        "operating_observations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["observation_id", "claim_id", "metric", "value", "unit", "measurement_basis", "period_start", "period_end", "source_ids"],
            "properties": {
              "observation_id": {"type": "string", "pattern": "^HBTOBS:"},
              "claim_id": {"type": "string", "pattern": "^HBTCLM:"},
              "metric": {"type": "string", "minLength": 1},
              "value": {},
              "unit": {"type": "string", "minLength": 1},
              "measurement_basis": {"type": "string", "minLength": 1},
              "period_start": {"type": "string", "minLength": 10},
              "period_end": {"type": "string", "minLength": 10},
              "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
            }
          }
        }
      }
    },
    "report_coverage": {"type": "object", "required": ["status", "supported_claim_count", "unsupported_claim_count", "unknowns_preserved", "notes"], "properties": {"status": {"enum": ["PASS", "PARTIAL", "INCOMPLETE", "INVALID"]}, "supported_claim_count": {"type": "integer", "minimum": 0}, "unsupported_claim_count": {"type": "integer", "minimum": 0}, "unknowns_preserved": {"type": "boolean"}, "notes": {"type": "array", "items": {"type": "string"}}}},
    "model_forecast_error": {"type": "object", "required": ["status", "metrics", "notes"], "properties": {"status": {"enum": ["CALCULATED", "PARTIAL", "NOT_CALCULABLE"]}, "metrics": {"type": "array", "items": {"type": "object", "required": ["claim_id", "observation_id", "metric", "forecast_value", "actual_value", "unit", "actual_source_ids"], "properties": {"claim_id": {"type": "string", "pattern": "^HBTCLM:"}, "observation_id": {"type": "string", "pattern": "^HBTOBS:"}, "metric": {"type": "string", "minLength": 1}, "forecast_value": {"type": "number"}, "actual_value": {"type": "number"}, "unit": {"type": "string", "minLength": 1}, "actual_source_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}}}, "notes": {"type": "array", "items": {"type": "string"}}}},
    "investment_return_outcome": {"type": "object", "required": ["status", "action", "total_return", "benchmark_return", "currency", "notes"], "properties": {"status": {"enum": ["CALCULATED", "PARTIAL", "NOT_CALCULABLE"]}, "action": {"enum": ["BUY", "HOLD", "WAIT", "SELL", "NO_BUY", "UNKNOWN"]}, "total_return": {"type": ["number", "null"]}, "benchmark_return": {"type": ["number", "null"]}, "currency": {"type": "string"}, "notes": {"type": "array", "items": {"type": "string"}}}},
    "status": {"enum": ["REVIEWABLE", "INCOMPLETE", "INVALID"]}
  }
}
