{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://turtle.local/schemas/historical_backtest_experiment.schema.json",
  "title": "Turtle Historical Backtest Experiment",
  "type": "object",
  "required": ["schema_version", "experiment_id", "status", "registered_at", "framework", "information_policy", "universe", "scoring_policy"],
  "properties": {
    "schema_version": {"const": "historical-backtest-experiment.v1"},
    "experiment_id": {"type": "string", "pattern": "^HBT:"},
    "status": {"enum": ["PRE_REGISTERED", "REPORT_FROZEN", "SETTLEMENT_OPEN", "COMPLETE", "INVALID"]},
    "registered_at": {"type": "string"},
    "framework": {
      "type": "object",
      "required": ["framework_version", "route_policy", "golden_gate_state"],
      "properties": {
        "framework_version": {"type": "string", "minLength": 1},
        "route_policy": {"type": "string", "minLength": 1},
        "golden_gate_state": {"const": "G3_NOT_READY"}
      }
    },
    "information_policy": {
      "type": "object",
      "required": ["cutoff_timezone", "source_rule", "current_restated_data_rule", "future_file_rule", "survivorship_rule", "execution_rule"],
      "properties": {
        "cutoff_timezone": {"type": "string", "minLength": 1},
        "source_rule": {"const": "published_at_and_data_as_of_must_not_exceed_cutoff"},
        "current_restated_data_rule": {"const": "current_restated_values_are_ineligible_without_historical_vintage"},
        "future_file_rule": {"const": "future_files_are_unreadable_before_settlement"},
        "survivorship_rule": {"const": "retain_delisted_acquired_and_failed_cases_in_registered_universe"},
        "execution_rule": {"type": "string", "minLength": 1}
      }
    },
    "universe": {
      "type": "object",
      "required": ["selection_status", "cases", "eligible_case_count"],
      "properties": {
        "selection_status": {"enum": ["PRE_REGISTERED", "USER_SELECTED_CASE", "RESEARCH_PILOT"]},
        "cases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["case_id", "company_code", "company_name", "eligibility_status", "eligibility_reason"],
            "properties": {
              "case_id": {"type": "string", "pattern": "^HBTCASE:"},
              "company_code": {"type": "string", "minLength": 1},
              "company_name": {"type": "string", "minLength": 1},
              "eligibility_status": {"enum": ["ELIGIBLE", "INELIGIBLE_NO_HISTORICAL_VINTAGE", "INELIGIBLE_INCOMPLETE_OUTCOMES", "INELIGIBLE_SURVIVORSHIP_UNRESOLVED", "INELIGIBLE_OTHER"]},
              "eligibility_reason": {"type": "string", "minLength": 1},
              "route": {"enum": ["LONG_TERM_OWNER", "FINITE_XIRR", "DUAL"]}
            }
          }
        },
        "eligible_case_count": {"type": "integer", "minimum": 0}
      }
    },
    "scoring_policy": {
      "type": "object",
      "required": ["separate_dimensions", "no_compensating_score", "minimum_outcome_fields"],
      "properties": {
        "separate_dimensions": {"const": ["REPORT_COVERAGE", "MODEL_FORECAST_ERROR", "INVESTMENT_RETURN_OUTCOME"]},
        "no_compensating_score": {"const": true},
        "minimum_outcome_fields": {"type": "array", "items": {"type": "string"}, "minItems": 1}
      }
    }
  }
}
