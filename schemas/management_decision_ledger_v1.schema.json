{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://turtle.local/schemas/management_decision_ledger_v1.schema.json",
  "title": "Turtle Append-only ManagementDecisionLedger v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ledger_id", "company_id", "created_at", "append_policy", "events"],
  "properties": {
    "schema_version": {"const": "management-decision-ledger.v1"},
    "ledger_id": {"type": "string", "minLength": 1},
    "company_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "append_policy": {"const": "EVENT_SUFFIX_ONLY"},
    "events": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["event_id", "sequence", "decision_id", "event_type", "recorded_at", "effective_at", "evidence_refs"],
        "properties": {
          "event_id": {"type": "string", "minLength": 1},
          "sequence": {"type": "integer", "minimum": 1},
          "decision_id": {"type": "string", "minLength": 1},
          "event_type": {"enum": ["DECISION_RECORDED", "STATUS_CHANGED", "EVIDENCE_ATTACHED"]},
          "recorded_at": {"type": "string", "format": "date-time"},
          "effective_at": {"type": "string", "format": "date-time"},
          "status": {"$ref": "#/$defs/decision_status"},
          "from_status": {"$ref": "#/$defs/decision_status"},
          "to_status": {"$ref": "#/$defs/decision_status"},
          "responsibility_unit_id": {"type": "string", "minLength": 1},
          "arena_id": {"type": "string", "minLength": 1},
          "responsible_party": {"type": "string", "minLength": 1},
          "problem_statement": {"type": "string", "minLength": 1},
          "expected_mechanism_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "strongest_counterargument": {"type": "string", "minLength": 1},
          "observable_signal_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "financial_transmission_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "unknowns": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "evidence_refs": {"type": "array", "items": {"type": "string"}},
          "rationale": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {"properties": {"event_type": {"const": "DECISION_RECORDED"}}, "required": ["event_type"]},
            "then": {"required": ["status", "responsibility_unit_id", "arena_id", "responsible_party", "problem_statement", "expected_mechanism_ids", "strongest_counterargument", "observable_signal_ids", "financial_transmission_ids", "unknowns"]}
          },
          {
            "if": {"properties": {"event_type": {"const": "STATUS_CHANGED"}}, "required": ["event_type"]},
            "then": {"required": ["from_status", "to_status", "rationale"]}
          }
        ]
      }
    }
  },
  "$defs": {
    "decision_status": {"enum": ["PLANNED", "COMMITTED", "IMPLEMENTED", "EXPOSED", "REALIZED", "CANCELLED", "INSUFFICIENT_EVIDENCE"]}
  }
}
