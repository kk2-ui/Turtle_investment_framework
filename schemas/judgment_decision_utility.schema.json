{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "judgment-decision-utility.v3",
  "title": "Turtle canonical Episode decision utility contracts",
  "$defs": {
    "contract_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_id", "contract_version"],
      "properties": {
        "contract_id": {"type": "string", "minLength": 1},
        "contract_version": {"type": "integer", "minimum": 1}
      }
    },
    "pairing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "pairing_id", "decision_contract_ref",
        "baseline_episode_id", "enhanced_episode_id",
        "baseline_method_id", "enhanced_method_id",
        "baseline_research_cost_hours", "enhanced_research_cost_hours",
        "frozen_at", "object_class", "claim_class", "allowed_outputs"
      ],
      "properties": {
        "schema_version": {"const": "turtle-decision-utility-pairing.v2"},
        "pairing_id": {"type": "string", "minLength": 1},
        "decision_contract_ref": {"$ref": "#/$defs/contract_ref"},
        "baseline_episode_id": {"type": "string", "minLength": 1},
        "enhanced_episode_id": {"type": "string", "minLength": 1},
        "baseline_method_id": {"type": "string", "minLength": 1},
        "enhanced_method_id": {"type": "string", "minLength": 1},
        "baseline_research_cost_hours": {"type": "number", "minimum": 0},
        "enhanced_research_cost_hours": {"type": "number", "minimum": 0},
        "frozen_at": {"type": "string", "format": "date-time"},
        "object_class": {"const": "DECISION_UTILITY_PAIRING"},
        "claim_class": {"const": "SAME_CONTRACT_METHOD_ABLATION"},
        "allowed_outputs": {"const": ["DECISION_UTILITY_EVALUATION_ONLY", "RESEARCH_AGENDA"]}
      }
    },
    "dimension_finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension_id", "baseline_assessment", "enhanced_assessment", "supporting_cell_ids", "rationale"],
      "properties": {
        "dimension_id": {
          "enum": [
            "INITIAL_CONDITIONS", "IMPLEMENTED_MANAGEMENT_ACTION", "EXECUTION",
            "CUSTOMER_COMPETITION_RESPONSE", "UNIT_ECONOMICS",
            "WORKING_CAPITAL_CASH_CAPITAL", "ADAPTATION_PERMANENT_LOSS",
            "STRONGEST_ALTERNATIVE_EXPLANATION"
          ]
        },
        "baseline_assessment": {"enum": ["AVOIDED_ERROR", "MATERIAL_IMPROVEMENT", "NO_DIFFERENCE", "UNKNOWN", "NOT_DIAGNOSTIC"]},
        "enhanced_assessment": {"enum": ["AVOIDED_ERROR", "MATERIAL_IMPROVEMENT", "NO_DIFFERENCE", "UNKNOWN", "NOT_DIAGNOSTIC"]},
        "supporting_cell_ids": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "rationale": {"type": "string", "minLength": 1}
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "evaluation_id", "pairing_id", "evaluated_at", "reviewer_id",
        "outcome_settlement_ref", "dimension_findings", "holdout", "object_class",
        "claim_class", "allowed_outputs"
      ],
      "properties": {
        "schema_version": {"const": "turtle-decision-utility-evaluation.v3"},
        "evaluation_id": {"type": "string", "minLength": 1},
        "pairing_id": {"type": "string", "minLength": 1},
        "evaluated_at": {"type": "string", "format": "date-time"},
        "reviewer_id": {"type": "string", "minLength": 1},
        "outcome_settlement_ref": {"type": "string", "minLength": 1},
        "dimension_findings": {
          "type": "array", "minItems": 8, "maxItems": 8,
          "items": {"$ref": "#/$defs/dimension_finding"}
        },
        "holdout": {
          "type": "object",
          "additionalProperties": false,
          "required": ["training_company_ids", "holdout_company_ids", "training_cutoff_through", "holdout_cutoff_from"],
          "properties": {
            "training_company_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "holdout_company_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "training_cutoff_through": {"type": "string", "format": "date-time"},
            "holdout_cutoff_from": {"type": "string", "format": "date-time"}
          }
        },
        "object_class": {"const": "DECISION_UTILITY_EVALUATION"},
        "claim_class": {"const": "MATERIAL_DECISION_UTILITY_REVIEW"},
        "allowed_outputs": {"const": ["DECISION_UTILITY_EVALUATION_ONLY", "RESEARCH_AGENDA"]}
      }
    }
  }
}
