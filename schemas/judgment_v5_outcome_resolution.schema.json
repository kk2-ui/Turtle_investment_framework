{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://turtle.local/schemas/judgment_v5_outcome_resolution.schema.json",
  "title": "Turtle V5 sealed-outcome reconstruction input",
  "description": "Slice 0 consumes the single canonical V5 candidate bundle plus custodian-only raw outcome receipts. The candidate bundle has no outcome source identity, title, availability time, or value.",
  "type": "object",
  "additionalProperties": false,
  "required": ["selection_bundle", "outcome_receipts"],
  "properties": {
    "selection_bundle": {
      "allOf": [
        {"$ref": "judgment_selection_admission_v5.schema.json"},
        {
          "type": "object",
          "required": ["selection_freeze_id", "outcome_contract"],
          "properties": {
            "selection_freeze_id": {"$ref": "#/$defs/id"},
            "outcome_contract": {"$ref": "#/$defs/outcome_contract"}
          }
        }
      ]
    },
    "outcome_receipts": {"$ref": "#/$defs/outcome_receipts"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1},
    "economic_period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "string", "format": "date-time"},
        "end": {"type": "string", "format": "date-time"}
      }
    },
    "frozen_matrix_cell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuer_id", "metric_id", "period_id", "observation_role", "field_id", "economic_period", "perimeter_id", "currency_and_unit", "field_locator"],
      "properties": {
        "issuer_id": {"$ref": "#/$defs/id"},
        "metric_id": {"$ref": "#/$defs/id"},
        "period_id": {"$ref": "#/$defs/id"},
        "observation_role": {"enum": ["BASELINE", "PRIMARY_OUTCOME", "EARLY_ARROW_NON_VOTER"]},
        "field_id": {"$ref": "#/$defs/id"},
        "economic_period": {"$ref": "#/$defs/economic_period"},
        "perimeter_id": {"$ref": "#/$defs/id"},
        "currency_and_unit": {"$ref": "#/$defs/id"},
        "field_locator": {"$ref": "#/$defs/id"}
      }
    },
    "fiscal_calendar_bridge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["NOT_REQUIRED", "FROZEN"]},
        "bridge_id": {"$ref": "#/$defs/id"},
        "comparison_window_id": {"$ref": "#/$defs/id"}
      }
    },
    "outcome_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frozen_raw_matrix", "fiscal_calendar_bridge"],
      "properties": {
        "frozen_raw_matrix": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/frozen_matrix_cell"}},
        "fiscal_calendar_bridge": {"$ref": "#/$defs/fiscal_calendar_bridge"}
      }
    },
    "source_availability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "source_available_at", "availability_precision", "filing_identity"],
      "properties": {
        "source_id": {"$ref": "#/$defs/id"},
        "source_available_at": {"type": "string", "minLength": 1},
        "availability_precision": {"enum": ["INTRADAY", "DATE_ONLY"]},
        "filing_identity": {"enum": ["INITIAL", "RESTATED"]},
        "restatement_series_id": {"$ref": "#/$defs/id"}
      }
    },
    "raw_cell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuer_id", "clock", "metric_id", "period_id", "field_id", "value", "source"],
      "properties": {
        "issuer_id": {"$ref": "#/$defs/id"},
        "clock": {"enum": ["D3", "D4"]},
        "metric_id": {"$ref": "#/$defs/id"},
        "period_id": {"$ref": "#/$defs/id"},
        "field_id": {"$ref": "#/$defs/id"},
        "value": {"type": "number"},
        "source": {"$ref": "#/$defs/source_availability"}
      }
    },
    "boundary_fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["boundary_kind", "source"],
      "properties": {
        "boundary_kind": {"enum": ["MEASUREMENT", "SCOPE", "PANEL", "MECHANISM"]},
        "reason": {"type": "string", "minLength": 1},
        "source": {"$ref": "#/$defs/source_availability"}
      }
    },
    "outcome_receipts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "custodian_attestation", "raw_cells"],
      "properties": {
        "schema_version": {"const": "judgment-v5-outcome-receipts.v1"},
        "custodian_attestation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["custodian_id", "research_side_outcome_exposure"],
          "properties": {
            "custodian_id": {"$ref": "#/$defs/id"},
            "research_side_outcome_exposure": {"enum": ["NONE", "CONFIRMED"]}
          }
        },
        "raw_cells": {"type": "array", "items": {"$ref": "#/$defs/raw_cell"}},
        "boundary_facts": {"type": "array", "items": {"$ref": "#/$defs/boundary_fact"}}
      }
    }
  }
}
