{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "run_manifest.schema.json",
  "type": "object",
  "required": ["schema_version", "run_id", "status", "identity", "versions", "input_fingerprints", "steps", "llm_calls", "usage", "cache", "artifacts", "publication", "manifest_fingerprint"],
  "properties": {
    "schema_version": {"const": "run-manifest.v1"},
    "run_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["RUNNING", "PAUSED", "INCOMPLETE", "FAILED", "BLOCKED", "COMPLETED"]},
    "identity": {"type": "object", "required": ["company_code", "period"]},
    "versions": {"type": "object", "required": ["code", "config", "prompt"]},
    "input_fingerprints": {"type": "object", "additionalProperties": {"type": "string"}},
    "steps": {"type": "array", "items": {"type": "object"}},
    "llm_calls": {"type": "array", "items": {"type": "object"}},
    "usage": {"type": "object", "required": ["calls", "input_tokens", "output_tokens", "llm_duration_sec", "retry_attempts", "estimated_cost_usd"]},
    "cache": {"type": "object", "required": ["hits", "misses", "writes", "invalid"]},
    "artifacts": {"type": "array", "items": {"type": "object"}},
    "publication": {"type": "object"},
    "manifest_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
