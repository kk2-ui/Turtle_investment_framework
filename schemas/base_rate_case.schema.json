{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://turtle.local/schemas/base_rate_case.schema.json",
  "title": "Turtle Base Rate Case",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "case_status_at_capture", "report_id", "as_of", "information_cutoff", "archetype_ids", "mechanism_keys", "variable_keys", "decisive_question", "source_capture", "visible_evidence", "prediction", "comparability", "created_at", "case_fingerprint"],
  "properties": {
    "schema_version": {"const": "base-rate-case.v1"},
    "case_id": {"type": "string", "pattern": "^CASE:"},
    "case_status_at_capture": {"enum": ["CANDIDATE", "REVIEWABLE"]},
    "report_id": {"type": "string", "minLength": 1},
    "as_of": {"type": "string", "format": "date"},
    "information_cutoff": {"type": "string", "format": "date"},
    "archetype_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "mechanism_keys": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "variable_keys": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "decisive_question": {"type": "object", "required": ["question_id", "topic_family", "question"]},
    "source_capture": {"type": "object", "required": ["kind", "artifact_id", "artifact_sha256"]},
    "visible_evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
    "prediction": {"$ref": "#/$defs/prediction"},
    "comparability": {"type": "object", "required": ["population_definition", "inclusion_rule", "exclusion_rule"]},
    "episode": {"$ref": "#/$defs/episode"},
    "case_selection": {"$ref": "#/$defs/case_selection"},
    "extraction_notes": {"type": "string"},
    "created_at": {"type": "string"},
    "case_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "required": ["source_id", "source_group_id", "sha256", "disclosed_at", "data_as_of"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "source_group_id": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "disclosed_at": {"type": ["string", "null"]},
        "data_as_of": {"type": ["string", "null"]}
      }
    },
    "prediction": {
      "type": "object",
      "required": ["status", "outcome_space", "resolution_due"],
      "properties": {
        "status": {"enum": ["NOT_ASSIGNED", "RECORDED"]},
        "outcome_space": {"type": "array", "minItems": 2, "items": {"type": "object", "required": ["scenario_id", "label", "mechanism"]}},
        "resolution_due": {"type": "string", "format": "date"},
        "probability_kind": {"enum": ["frequency", "base_rate", "analyst_subjective", "scenario_weight"]},
        "probabilities": {"type": "array", "items": {"type": "object", "required": ["scenario_id", "value", "interval"]}},
        "basis": {"type": "string"},
        "as_of": {"type": "string", "format": "date"}
      }
    },
    "episode": {
      "type": "object",
      "required": ["episode_id", "industry_regime", "common_question_set_id", "terminal_outcome_scope", "mechanism_chain_ids", "strongest_alternative_id", "financial_driver_bridge", "forward_judgment_ids", "baseline_ids", "cluster", "settlement_status"],
      "properties": {
        "episode_id": {"type": "string", "pattern": "^MEP:"},
        "industry_regime": {"type": "string", "minLength": 1},
        "common_question_set_id": {"type": "string", "minLength": 1},
        "terminal_outcome_scope": {"type": "string", "minLength": 1},
        "mechanism_chain_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "strongest_alternative_id": {"type": "string", "minLength": 1},
        "financial_driver_bridge": {"type": "object", "required": ["state"], "properties": {"state": {"enum": ["BOUND", "UNKNOWN"]}, "reference": {"type": "string"}, "conservative_treatment": {"type": "string"}}},
        "forward_judgment_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "baseline_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "cluster": {"type": "object", "required": ["company_id", "period_cluster_id", "mechanism_cluster_id"]},
        "settlement_status": {"enum": ["OPEN", "SETTLED", "UNRESOLVED"]}
      }
    },
    "case_selection": {
      "type": "object",
      "required": ["register_id", "register_fingerprint", "entry_id", "outcome_isolation"],
      "properties": {
        "register_id": {"type": "string", "pattern": "^CSR:"},
        "register_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "entry_id": {"type": "string", "pattern": "^CSRSEL:"},
        "outcome_isolation": {"enum": ["PIT_PRE_OUTCOME", "OUTCOME_SELECTED_RESEARCH_ONLY"]}
      }
    }
  }
}
