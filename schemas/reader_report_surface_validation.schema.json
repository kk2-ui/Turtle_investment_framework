{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://turtle.local/schemas/reader_report_surface_validation.schema.json",
  "title": "Reader Report Surface Validation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "blocking_findings",
    "technical_heading_count",
    "reader_heading_count",
    "canonical_reader_slot_count",
    "reader_slot_cardinality",
    "policy"
  ],
  "properties": {
    "schema_version": {"const": "reader-report-surface-validation.v1"},
    "status": {"enum": ["PASS", "BLOCKED"]},
    "blocking_findings": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "technical_heading_count": {"type": "integer", "minimum": 0},
    "reader_heading_count": {"type": "integer", "minimum": 0},
    "canonical_reader_slot_count": {"type": "integer", "minimum": 0},
    "reader_slot_cardinality": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slot_id",
          "reader_count",
          "technical_count",
          "executive_count",
          "status"
        ],
        "properties": {
          "slot_id": {"type": "string", "minLength": 1},
          "reader_count": {"type": "integer", "minimum": 0},
          "technical_count": {"type": "integer", "minimum": 0},
          "executive_count": {"type": "integer", "minimum": 0},
          "status": {"enum": ["PASS", "BLOCKED"]}
        }
      }
    },
    "policy": {
      "const": "full_narrative_projection; control_bindings_technical_only; no_summary_substitution"
    }
  }
}
