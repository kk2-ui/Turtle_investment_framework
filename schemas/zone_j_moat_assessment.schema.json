{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Moat Assessment (J1)",
  "type": "object",
  "definitions": {
    "audit_param": {
      "type": "object",
      "properties": {
        "value": { "type": "number" },
        "rationale": { "type": "string" },
        "evidence_ref": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "confidence": {
          "type": "string",
          "enum": ["high", "medium", "low"]
        }
      },
      "required": ["value", "rationale", "evidence_ref", "confidence"],
      "additionalProperties": true
    }
  },
  "properties": {
    "_provenance": {
      "type": "object",
      "properties": {
        "generated_at": { "type": "string" },
        "agent": { "type": "string" },
        "context_files": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "master_source": { "type": "string" },
    "info_richness": { "type": "string", "enum": ["A", "B", "C"] },
    "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
    "dissenting_view": { "type": "string" },
    "moat_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": { "type": "string" },
          "evidence": { "type": "string" },
          "quote": { "type": "string" },
          "durability": { "type": "string" }
        },
        "required": ["type", "evidence", "quote", "durability"],
        "additionalProperties": true
      }
    },
    "b_class_segments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "revenue_pct": { "type": "number" },
          "margin_pct": { "type": "number" },
          "classification": { "type": "string" },
          "penalty_pct": { "type": "number" }
        },
        "required": ["name", "classification", "penalty_pct"],
        "additionalProperties": true
      }
    },
    "b_penalty_final": {
      "allOf": [
        { "$ref": "#/definitions/audit_param" },
        {
          "properties": {
            "value": { "type": "number", "minimum": 0.0, "maximum": 0.5 }
          }
        }
      ]
    },
    "g_base": {
      "allOf": [
        { "$ref": "#/definitions/audit_param" },
        {
          "properties": {
            "value": { "type": "number", "minimum": 0.0, "maximum": 10.0 }
          }
        }
      ]
    },
    "g_scenarios": {
      "type": "object",
      "properties": {
        "pessimistic": { "type": "number" },
        "base": { "type": "number" },
        "optimistic": { "type": "number" }
      },
      "required": ["pessimistic", "base", "optimistic"],
      "additionalProperties": true
    },
    "value_trap_signals": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "required": ["moat_evidence", "b_penalty_final", "g_base", "g_scenarios", "value_trap_signals"],
  "additionalProperties": true
}
