{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "judgment-review.v1",
  "type": "object",
  "required": [
    "schema_version", "report_id", "reviewer_mode", "ceiling_verdict",
    "verdict_basis", "distinctive_insight", "competent_but_conventional",
    "fragile_leaps", "competitive_explanation_test", "missing_information",
    "decision_dependency", "dimension_assessments", "reviewer_limits"
  ],
  "properties": {
    "schema_version": {"const": "judgment-review.v1"},
    "reviewer_mode": {"const": "independent_challenger"},
    "ceiling_verdict": {"enum": ["INSIGHTFUL", "COMPETENT", "FRAGILE", "NOT_ASSESSABLE"]},
    "distinctive_insight": {"type": "object"},
    "competent_but_conventional": {"type": "array", "minItems": 1},
    "fragile_leaps": {"type": "array"},
    "competitive_explanation_test": {"type": "object"},
    "missing_information": {"type": "array", "minItems": 1},
    "decision_dependency": {"type": "object"},
    "dimension_assessments": {"type": "object"},
    "reviewer_limits": {"type": "array", "minItems": 1}
  }
}
