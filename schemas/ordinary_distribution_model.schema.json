{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://turtle.local/schemas/ordinary_distribution_model.schema.json",
  "title": "Turtle deterministic ordinary-share distribution model",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "model_id", "company_id", "cutoff_at", "position_as_of",
    "as_of", "currency", "unit", "input_fact_ids",
    "normalized_ordinary_share_operating_earnings", "ordinary_distribution_rate",
    "gross_common_distribution", "distribution_tax_and_collection_friction_rate",
    "variable_tax_and_collection_friction", "fixed_collection_cost",
    "after_tax_common_distribution", "economic_identity", "valuation_destination"
  ],
  "properties": {
    "schema_version": {"const": "ordinary-distribution-model.v1"},
    "model_id": {"$ref": "#/$defs/nonempty"},
    "company_id": {"$ref": "#/$defs/nonempty"},
    "cutoff_at": {"$ref": "#/$defs/nonempty"},
    "position_as_of": {"$ref": "#/$defs/nonempty"},
    "as_of": {"$ref": "#/$defs/nonempty"},
    "currency": {"$ref": "#/$defs/nonempty"},
    "unit": {"$ref": "#/$defs/nonempty"},
    "input_fact_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "#/$defs/nonempty"}
    },
    "normalized_ordinary_share_operating_earnings": {"$ref": "#/$defs/nonnegative"},
    "ordinary_distribution_rate": {"$ref": "#/$defs/rate"},
    "gross_common_distribution": {"$ref": "#/$defs/nonnegative"},
    "distribution_tax_and_collection_friction_rate": {"$ref": "#/$defs/rate"},
    "variable_tax_and_collection_friction": {"$ref": "#/$defs/nonnegative"},
    "fixed_collection_cost": {"$ref": "#/$defs/nonnegative"},
    "after_tax_common_distribution": {"$ref": "#/$defs/nonnegative"},
    "economic_identity": {
      "const": "normalized_earnings_times_distribution_rate_less_tax_and_collection_friction"
    },
    "valuation_destination": {"const": "ordinary_share_distribution_return"}
  },
  "$defs": {
    "nonempty": {"type": "string", "minLength": 1},
    "nonnegative": {"type": "number", "minimum": 0},
    "rate": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
