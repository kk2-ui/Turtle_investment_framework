{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://turtle.local/schemas/judgment_boundary_case.schema.json",
  "title": "Historical Boundary / Abstention Case",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "experiment_id", "company_id", "company_cluster_id", "industry_id", "cutoff_at", "freeze_id", "selection_status", "boundary_question", "shared_facts", "unknowns", "boundary_rule", "independent_review"],
  "properties": {
    "schema_version": {"const": "judgment-boundary-case.v1"},
    "case_id": {"type": "string", "pattern": "^BOUNDARYCASE:[A-Za-z0-9._:-]+$"},
    "experiment_id": {"type": "string", "minLength": 1},
    "company_id": {"type": "string", "minLength": 1},
    "company_cluster_id": {"type": "string", "minLength": 1},
    "industry_id": {"type": "string", "minLength": 1},
    "cutoff_at": {"type": "string", "format": "date-time"},
    "freeze_id": {"type": "string", "pattern": "^BFREEZE:[A-Za-z0-9._:-]+$"},
    "selection_status": {"const": "NO_PRIMARY"},
    "boundary_question": {"type": "string", "minLength": 1},
    "shared_facts": {"type": "array", "minItems": 1},
    "unknowns": {"type": "array", "minItems": 1},
    "boundary_rule": {"type": "object"},
    "independent_review": {"type": "object"}
  }
}
