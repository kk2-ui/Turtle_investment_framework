{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://turtle.local/schemas/base_rate_policy.schema.json",
  "title": "Turtle Base Rate Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "enforced", "created_at", "context_fingerprint", "library_fingerprint_at_plan", "minimum_empirical_sample"],
  "properties": {
    "schema_version": {"const": "base-rate-policy.v1"},
    "run_id": {"type": "string", "minLength": 1},
    "enforced": {"type": "boolean"},
    "created_at": {"type": "string"},
    "context_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "library_fingerprint_at_plan": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "minimum_empirical_sample": {"const": 5}
  }
}
