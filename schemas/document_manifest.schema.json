{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://turtle.local/schemas/document_manifest.schema.json",
  "title": "Turtle Official Evidence Document Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_id", "issuer", "code", "market", "documents", "manifest_hash", "validation"],
  "properties": {
    "schema_version": {"const": "document-manifest.v1"},
    "report_id": {"type": "string", "minLength": 1},
    "issuer": {"type": "string", "minLength": 1},
    "code": {"type": "string", "minLength": 1},
    "market": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string"},
    "documents": {
      "type": "array",
      "items": {"$ref": "#/$defs/document"}
    },
    "manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "validation": {"$ref": "#/$defs/validation"}
  },
  "$defs": {
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["doc_id", "report_id", "issuer", "code", "market", "doc_type", "fiscal_period", "period_end", "authority", "source_url", "local_path", "sha256", "mime_type", "language", "acquisition_status"],
      "properties": {
        "doc_id": {"type": "string", "pattern": "^DOC:"},
        "report_id": {"type": "string", "minLength": 1},
        "issuer": {"type": "string", "minLength": 1},
        "code": {"type": "string", "minLength": 1},
        "market": {"type": "string", "minLength": 1},
        "doc_type": {"enum": ["annual_report", "interim_report", "annual_report_text", "interim_report_text", "company_announcement", "official_statistics", "other_official"]},
        "fiscal_period": {"type": "string", "minLength": 1},
        "period_end": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "published_at": {"type": ["string", "null"]},
        "authority": {"enum": ["audited_filing", "company_filing", "official_statistics", "other_official", "derived"]},
        "source_url": {"type": ["string", "null"]},
        "local_path": {"type": "string", "minLength": 1},
        "derived_text_path": {"type": ["string", "null"]},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "mime_type": {"type": "string", "minLength": 1},
        "language": {"type": "string", "minLength": 1},
        "acquisition_status": {"enum": ["CACHED", "DOWNLOADED", "DERIVED_ONLY", "FAILED"]}
      }
    },
    "validation": {
      "type": "object",
      "required": ["state", "invalid_findings", "incomplete_findings", "warnings"],
      "properties": {
        "state": {"enum": ["INVALID", "INCOMPLETE", "REVIEWABLE"]},
        "invalid_findings": {"type": "array", "items": {"type": "string"}},
        "incomplete_findings": {"type": "array", "items": {"type": "string"}},
        "warnings": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
