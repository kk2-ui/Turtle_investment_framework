{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://turtle.local/schemas/judgment_learning_admission.schema.json",
  "title": "Judgment Learning Admission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "learning_note_ref",
    "feedback_ref",
    "control_plane_db",
    "feedback_item_id",
    "learning_note_event_id",
    "learning_note_effective_at"
  ],
  "properties": {
    "schema_version": {
      "const": "judgment-learning-admission.v1"
    },
    "learning_note_ref": {
      "type": "string",
      "minLength": 1
    },
    "feedback_ref": {
      "type": "string",
      "minLength": 1
    },
    "control_plane_db": {
      "type": "string",
      "minLength": 1
    },
    "feedback_item_id": {
      "type": "string",
      "pattern": "^FBI:[A-Za-z0-9._:-]+$"
    },
    "learning_note_event_id": {
      "type": "string",
      "minLength": 1
    },
    "learning_note_effective_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
