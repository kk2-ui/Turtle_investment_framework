{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "enterprise_judgment_v3.schema.json",
  "title": "Turtle Enterprise Judgment V3 Offline Control Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "enterprise_system_model", "responsibility_units", "competitive_arenas", "scope_bridges", "management_decision_ledger", "cjo"],
  "properties": {
    "schema_version": {"const": "enterprise-judgment-v3.v1"},
    "enterprise_system_model": {"$ref": "#/$defs/enterprise_system_model"},
    "responsibility_units": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/responsibility_unit"}},
    "competitive_arenas": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/competitive_arena"}},
    "scope_bridges": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/scope_bridge"}},
    "management_decision_ledger": {"$ref": "#/$defs/management_decision_ledger"},
    "cjo": {"$ref": "#/$defs/cjo"}
  },
  "$defs": {
    "state_vector": {
      "type": "object", "additionalProperties": false,
      "required": ["lane", "lifecycle", "resolution", "permission"],
      "properties": {
        "lane": {"enum": ["ENTERPRISE_MODEL", "MANAGEMENT_DECISION", "MECHANISM_LAB", "BOUNDARY", "PIT", "HOLDOUT", "LIVE"]},
        "lifecycle": {"enum": ["DRAFT", "EVIDENCE_OPEN", "REVIEW_READY", "FROZEN", "REOPENED", "RETIRED"]},
        "resolution": {"enum": ["UNKNOWN", "NO_PRIMARY", "MIXED", "SELECTIVE_SUPPORT", "A_ONLY", "B_ONLY", "NOT_DIAGNOSTIC", "PIT_BLOCKED"]},
        "permission": {"enum": ["TEACHING_ONLY", "LEARNING_ELIGIBLE", "EVALUATION_ONLY", "INVESTMENT_INPUT", "REMEDIATION_ONLY"]},
        "frozen_at": {"type": "string", "format": "date-time"},
        "settlement_receipt": {"type": "string", "minLength": 1}, "independent_review_receipt": {"type": "string", "minLength": 1}
      }
    },
    "enterprise_system_model": {
      "type": "object", "additionalProperties": false,
      "required": ["model_id", "company_id", "version", "as_of", "nodes", "edges", "responsibility_unit_ids", "competitive_arena_ids"],
      "properties": {
        "model_id": {"type": "string", "minLength": 1}, "company_id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "as_of": {"type": "string", "format": "date-time"},
        "responsibility_unit_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "competitive_arena_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "nodes": {"type": "array", "items": {"type": "object", "required": ["node_id", "observation_state", "responsibility_unit_id", "measurement_scope_id"]}},
        "edges": {"type": "array", "items": {"type": "object", "required": ["edge_id", "from_node_id", "to_node_id", "relationship", "actor_side", "interface", "cross_side_effect", "measurement_scope_id", "observation_state"]}},
        "episode_deltas": {"type": "array", "items": {"type": "object", "required": ["episode_id", "resolution", "node_ids", "edge_ids"]}}
      }
    },
    "responsibility_unit": {
      "type": "object", "additionalProperties": false,
      "required": ["unit_id", "accounting_perimeter", "decision_scope", "economic_carrier", "measurement_surface"],
      "properties": {"unit_id": {"type": "string", "minLength": 1}, "accounting_perimeter": {"type": "string", "minLength": 1}, "decision_scope": {"type": "string", "minLength": 1}, "economic_carrier": {"type": "string", "minLength": 1}, "measurement_surface": {"type": "string", "minLength": 1}}
    },
    "competitive_arena": {
      "type": "object", "additionalProperties": false,
      "required": ["arena_id", "responsibility_unit_id", "product_or_service_scope", "customer_task", "competition_interface", "economic_state", "window", "required_overlap_dimensions", "members"],
      "properties": {"arena_id": {"type": "string", "minLength": 1}, "responsibility_unit_id": {"type": "string", "minLength": 1}, "product_or_service_scope": {"type": "string", "minLength": 1}, "customer_task": {"type": "string", "minLength": 1}, "competition_interface": {"type": "string", "minLength": 1}, "economic_state": {"type": "string", "minLength": 1}, "window": {"type": "string", "minLength": 1}, "required_overlap_dimensions": {"type": "array", "minItems": 1}, "members": {"type": "array", "minItems": 1}}
    },
    "scope_bridge": {
      "type": "object", "additionalProperties": false,
      "required": ["scope_bridge_id", "bridge_type", "responsibility_unit_id", "decision_scope_ref", "economic_carrier_ref", "measurement_surface_ref", "accounting_perimeter_ref", "permitted_conclusion_scope"],
      "properties": {"scope_bridge_id": {"type": "string", "minLength": 1}, "bridge_type": {"enum": ["IDENTITY", "SEGMENT_MATCH", "QUANTIFIED_ISSUER_AGGREGATION"]}, "responsibility_unit_id": {"type": "string", "minLength": 1}, "decision_scope_ref": {"type": "string", "minLength": 1}, "economic_carrier_ref": {"type": "string", "minLength": 1}, "measurement_surface_ref": {"type": "string", "minLength": 1}, "accounting_perimeter_ref": {"type": "string", "minLength": 1}, "permitted_conclusion_scope": {"type": "string", "minLength": 1}, "coverage_ratio": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}, "cash_attribution_ref": {"type": "string", "minLength": 1}}
    },
    "management_decision_ledger": {
      "type": "object", "additionalProperties": false, "required": ["ledger_id", "entries"],
      "properties": {"ledger_id": {"type": "string", "minLength": 1}, "entries": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["decision_id", "cutoff_at", "decision_type", "ex_ante"]}}}
    },
    "cjo": {
      "type": "object", "additionalProperties": false,
      "required": ["cjo_id", "model_id", "state", "scope_bridge_id", "owner_cash_bridge", "driver_register"],
      "properties": {"cjo_id": {"type": "string", "minLength": 1}, "model_id": {"type": "string", "minLength": 1}, "state": {"$ref": "#/$defs/state_vector"}, "scope_bridge_id": {"type": "string", "minLength": 1}, "owner_cash_bridge": {"type": "object", "required": ["status", "ordinary_share_access_status", "permanent_loss_status", "scope_bridge_id", "evidence_ref"]}, "driver_register": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["driver_id", "responsibility_unit_id", "scope_bridge_id", "normalized_earnings_delta", "owner_cash_delta"]}}}
    }
  }
}
