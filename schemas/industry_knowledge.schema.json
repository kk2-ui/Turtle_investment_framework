{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://turtle.local/schemas/industry_knowledge.schema.json",
  "title": "Turtle Industry Knowledge Base",
  "oneOf": [
    {"$ref": "#/$defs/policy"},
    {"$ref": "#/$defs/taxonomy"},
    {"$ref": "#/$defs/candidate"},
    {"$ref": "#/$defs/mechanism"}
  ],
  "$defs": {
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "library_role", "allowed_output", "prohibited_uses", "promotion_policy", "independence_policy"],
      "properties": {
        "schema_version": {"const": "industry-knowledge-policy.v1"},
        "library_role": {"const": "research_prompt_prior_only"},
        "allowed_output": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "prohibited_uses": {"type": "array", "minItems": 3, "items": {"type": "string"}},
        "promotion_policy": {"type": "object", "required": ["candidate_requires_direct_evidence", "corroborated_minimum_independent_corporate_groups", "concentrated_industry_minimum_distinct_reporting_periods", "mechanism_ready_requires_independent_review", "mechanism_ready_requires_settled_episode_evidence", "mechanism_ready_minimum_independent_settled_corporate_groups", "mechanism_ready_requires_boundary_or_counterexample"]},
        "independence_policy": {"type": "object", "required": ["same_corporate_group_not_independent", "same_reporting_period_cannot_substitute_for_independent_review"]}
      }
    },
    "taxonomy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "industry_families", "mechanism_families"],
      "properties": {
        "schema_version": {"const": "industry-knowledge-taxonomy.v1"},
        "industry_families": {"type": "array", "items": {"$ref": "#/$defs/taxonomyItem"}},
        "mechanism_families": {"type": "array", "items": {"$ref": "#/$defs/taxonomyItem"}}
      }
    },
    "taxonomyItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "description"],
      "properties": {
        "key": {"type": "string", "pattern": "^[a-z0-9_:-]+$"},
        "label": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "aliases": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_type", "reference_id", "source_id", "source_group_id", "authority", "published_at", "data_as_of", "statement", "direct_support"],
      "properties": {
        "evidence_type": {"enum": ["OBS", "DOC"]},
        "reference_id": {"type": "string", "pattern": "^(OBS|DOC):"},
        "source_id": {"type": "string", "minLength": 1},
        "source_group_id": {"type": "string", "minLength": 1},
        "authority": {"enum": ["audited_filing", "company_filing", "official_statistics", "industry_data", "regulator"]},
        "published_at": {"type": "string", "minLength": 4},
        "data_as_of": {"type": "string", "minLength": 4},
        "statement": {"type": "string", "minLength": 1},
        "direct_support": {"const": true}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "candidate_id", "status", "title", "mechanism_key", "industry_keys", "company_id", "corporate_group_id", "reporting_period", "insight", "applicability_conditions", "non_applicability_conditions", "alternative_explanations", "company_verification_fields", "evidence", "created_at"],
      "properties": {
        "schema_version": {"const": "industry-insight-candidate.v1"},
        "candidate_id": {"type": "string", "pattern": "^IKC:"},
        "status": {"enum": ["PROPOSED", "CANDIDATE", "REJECTED"]},
        "title": {"type": "string", "minLength": 1},
        "mechanism_key": {"type": "string", "pattern": "^[a-z0-9_:-]+$"},
        "industry_keys": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "archetype_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "company_id": {"type": "string", "minLength": 1},
        "corporate_group_id": {"type": "string", "minLength": 1},
        "reporting_period": {"type": "string", "minLength": 1},
        "insight": {"type": "string", "minLength": 1},
        "applicability_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "non_applicability_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "alternative_explanations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "company_verification_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
        "created_at": {"type": "string", "minLength": 1},
        "rejection_reason": {"type": "string", "minLength": 1}
      }
    },
    "mechanism": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "mechanism_id", "status", "mechanism_key", "title", "summary", "industry_keys", "candidate_ids", "applicability_conditions", "non_applicability_conditions", "alternative_explanations", "company_verification_fields", "prohibited_uses", "created_at", "updated_at"],
      "properties": {
        "schema_version": {"const": "industry-mechanism.v1"},
        "mechanism_id": {"type": "string", "pattern": "^IKM:"},
        "status": {"enum": ["CANDIDATE", "CORROBORATED", "MECHANISM_READY", "RETIRED", "REJECTED"]},
        "mechanism_key": {"type": "string", "pattern": "^[a-z0-9_:-]+$"},
        "title": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "industry_keys": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "archetype_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "candidate_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^IKC:"}},
        "applicability_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "non_applicability_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "alternative_explanations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "company_verification_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "prohibited_uses": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "author_id": {"type": "string", "minLength": 1},
        "concentrated_industry_exception": {"type": "object", "required": ["enabled", "rationale", "external_validity_limitation"], "properties": {"enabled": {"type": "boolean"}, "rationale": {"type": "string", "minLength": 1}, "external_validity_limitation": {"type": "string", "minLength": 1}}},
        "independent_review": {"type": "object", "required": ["reviewer_id", "reviewed_at", "scope", "outcome", "independent"], "properties": {"reviewer_id": {"type": "string", "minLength": 1}, "reviewed_at": {"type": "string", "minLength": 1}, "scope": {"type": "string", "minLength": 1}, "outcome": {"const": "ACCEPTED"}, "independent": {"const": true}}},
        "settled_episode_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["episode_id", "company_id", "corporate_group_id", "information_cutoff", "claim_id", "settlement_id", "settled_at", "outcome_artifact_ref", "review_artifact_ref", "reviewer_id", "independent_reviewed", "relationship_to_mechanism"],
            "properties": {
              "episode_id": {"type": "string", "minLength": 1},
              "company_id": {"type": "string", "minLength": 1},
              "corporate_group_id": {"type": "string", "minLength": 1},
              "information_cutoff": {"type": "string", "minLength": 4},
              "claim_id": {"type": "string", "minLength": 1},
              "settlement_id": {"type": "string", "minLength": 1},
              "settled_at": {"type": "string", "minLength": 1},
              "outcome_artifact_ref": {"type": "string", "minLength": 1},
              "review_artifact_ref": {"type": "string", "minLength": 1},
              "reviewer_id": {"type": "string", "minLength": 1},
              "independent_reviewed": {"const": true},
              "relationship_to_mechanism": {"enum": ["SUPPORTS", "CONTRADICTS", "BOUNDARY", "NOT_DIAGNOSTIC"]}
            }
          }
        },
        "created_at": {"type": "string", "minLength": 1},
        "updated_at": {"type": "string", "minLength": 1},
        "lifecycle_reason": {"type": "string", "minLength": 1},
        "review_notes": {"type": "string"}
      }
    }
  }
}
