{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://turtle.local/schemas/historical_backtest_case.v2.schema.json",
  "title": "Turtle Historical Backtest Frozen Case v2",
  "type": "object",
  "required": ["schema_version", "case_id", "experiment_id", "company_code", "simulation_cutoff", "purpose", "report_freeze", "credibility", "route", "forecast", "sources", "inputs", "calibration_ledger", "taxes_fees_fx", "price_identity", "status"],
  "properties": {
    "schema_version": {"const": "historical-backtest-case.v2"},
    "case_id": {"type": "string", "pattern": "^HBTCASE:"},
    "experiment_id": {"type": "string", "pattern": "^HBT:"},
    "company_code": {"type": "string", "minLength": 1},
    "purpose": {"enum": ["INVESTMENT_DECISION", "COMPANY_JUDGMENT_ONLY"]},
    "simulation_cutoff": {"type": "string", "minLength": 10},
    "report_freeze": {
      "type": "object",
      "required": ["frozen_at", "evidence_cutoff", "settlement_locked", "report_status", "mode", "freeze_id", "frozen_report", "independent_review", "quality_failure"],
      "properties": {
        "frozen_at": {"type": "string"},
        "evidence_cutoff": {"type": "string"},
        "settlement_locked": {"const": true},
        "report_status": {"enum": ["FROZEN", "FROZEN_WITH_QUALITY_FAILURE"]},
        "mode": {"enum": ["TEST_FIXTURE", "PRODUCTION_PIPELINE", "PIT_ENGINEERING"]},
        "freeze_id": {"type": "string", "pattern": "^HBTFRZ:"},
        "frozen_report": {
          "type": "object",
          "required": ["report_id", "variant_id", "origin", "artifact_path", "artifact_sha256", "format", "writer_id", "writer_provenance", "writer_status", "claim_ids", "section_markers"],
          "properties": {
            "report_id": {"type": "string", "pattern": "^HBTREP:"},
            "variant_id": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
            "origin": {
              "type": "object",
              "required": ["kind"],
              "properties": {
                "kind": {"enum": ["TEST_FIXTURE", "TURTLE_PIPELINE", "PIT_ENGINEERING"]},
                "output_dir": {"type": "string", "minLength": 1},
                "acceptance_root": {"type": "string", "minLength": 1},
                "sample_id": {"type": "string", "minLength": 1},
                "run_manifest_path": {"type": "string", "minLength": 1},
                "completion_report_path": {"type": "string", "minLength": 1},
                "publication_snapshot_path": {"type": "string", "minLength": 1},
                "review_artifact_path": {"type": "string", "minLength": 1},
                "pit_runner": {
                  "type": "object",
                  "description": "P10-A source-package runner declared-process attestation.",
                  "required": ["attestation_path", "source_package_manifest_path", "package_root", "status"],
                  "properties": {
                    "attestation_path": {"type": "string", "minLength": 1},
                    "source_package_manifest_path": {"type": "string", "minLength": 1},
                    "package_root": {"type": "string", "minLength": 1},
                    "status": {"enum": ["PASS", "INCOMPLETE", "INVALID"]}
                  }
                }
              }
            },
            "artifact_path": {"type": "string", "minLength": 1},
            "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "format": {"const": "MARKDOWN"},
            "writer_id": {"type": "string", "minLength": 1},
            "writer_provenance": {"$ref": "#/$defs/actor_provenance"},
            "writer_status": {"enum": ["COMPLETE", "QUALITY_FAILURE"]},
            "claim_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^HBTCLM:"}},
            "section_markers": {"type": "array", "minItems": 4, "items": {"type": "string", "minLength": 1}}
          }
        },
        "independent_review": {
          "type": "object",
            "required": ["review_id", "reviewed_variant_id", "reviewer_id", "reviewer_provenance", "independence", "reviewed_report_sha256", "status", "claim_reviews"],
            "properties": {
              "review_id": {"type": "string", "pattern": "^HBTREV:"},
              "reviewed_variant_id": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
            "reviewer_id": {"type": "string", "minLength": 1},
            "reviewer_provenance": {"$ref": "#/$defs/actor_provenance"},
            "independence": {"$ref": "#/$defs/reviewer_independence"},
            "reviewed_report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "status": {"enum": ["PASS", "FAIL"]},
            "claim_reviews": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["claim_id", "disposition", "source_ids", "notes"],
                "properties": {
                  "claim_id": {"type": "string", "pattern": "^HBTCLM:"},
                  "disposition": {"enum": ["SUPPORTED", "PARTIAL", "UNSUPPORTED", "UNKNOWN_PRESERVED"]},
                  "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
                  "notes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
                }
              }
            }
          }
        },
        "quality_failure": {
          "type": ["object", "null"],
          "properties": {
            "classifications": {"type": "array", "minItems": 1, "items": {"enum": ["DATA_COVERAGE", "ACQUISITION_MODULE", "REASONING", "MODEL", "WRITING"]}},
            "economic_impact": {"type": "string", "minLength": 1},
            "missing_facts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "prohibited_assumptions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "remediation": {"type": "string", "minLength": 1},
            "acceptance_criteria": {"type": "string", "minLength": 1}
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"mode": {"const": "PRODUCTION_PIPELINE"}},
            "required": ["mode"]
          },
          "then": {
            "properties": {
              "frozen_report": {
                "properties": {
                  "origin": {"required": ["pit_runner"]}
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {"mode": {"const": "PIT_ENGINEERING"}},
            "required": ["mode"]
          },
          "then": {
            "properties": {
              "frozen_report": {
                "properties": {
                  "origin": {"required": ["pit_runner", "review_artifact_path"]}
                }
              }
            }
          }
        }
      ]
    },
    "credibility": {
      "description": "Case-level model-memory assessment. A controlled candidate still needs the separately preregistered cross-issuer/cross-cutoff calibration design and holdout evidence.",
      "type": "object",
      "required": ["model_memory_control", "backtest_credibility", "assessment_basis", "control_evidence", "calibration_role"],
      "properties": {
        "model_memory_control": {"enum": ["CONTROLLED", "MITIGATED", "UNCONTROLLED"]},
        "backtest_credibility": {"enum": ["STRICT", "QUALIFIED", "EXPLORATORY"]},
        "assessment_basis": {"type": "string", "minLength": 1},
        "control_evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["evidence_id", "artifact_path", "artifact_sha256", "control_level", "method", "verifier_id", "scope"],
            "properties": {
              "evidence_id": {"type": "string", "pattern": "^HBTMEM:"},
              "artifact_path": {"type": "string", "minLength": 1},
              "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "control_level": {"enum": ["MITIGATION", "CONTROL"]},
              "method": {"type": "string", "minLength": 1},
              "verifier_id": {"type": "string", "minLength": 1},
              "scope": {"type": "string", "minLength": 1}
            }
          }
        },
        "calibration_role": {"enum": ["ENGINEERING_DIAGNOSTIC_ONLY", "MODEL_MEMORY_CONTROLLED_CANDIDATE"]}
      }
    },
    "route": {"enum": ["LONG_TERM_OWNER", "FINITE_XIRR", "DUAL"]},
    "forecast": {
      "type": "object",
      "required": ["horizon_years", "terminal_handling", "cash_flow_basis"],
      "properties": {
        "horizon_years": {"type": "number", "minimum": 0},
        "terminal_handling": {"enum": ["NO_REQUIRED_EXIT", "BUSINESS_VALUE_EXIT", "MARKET_EXIT", "LEGAL_END", "DUAL_TERMINAL_PATH"]},
        "cash_flow_basis": {"type": "string", "minLength": 1},
        "independent_terminal_evidence": {"type": "boolean"}
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_id", "source_version", "source_type", "published_at", "data_as_of", "revision_policy", "admissible"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "source_version": {"type": "string", "minLength": 1},
          "source_type": {"enum": ["ANNUAL_REPORT", "INTERIM_REPORT", "EXCHANGE_ANNOUNCEMENT", "OFFICIAL_STATISTICS", "MARKET_DATA", "OTHER_OFFICIAL"]},
          "published_at": {"type": "string"},
          "data_as_of": {"type": "string"},
          "revision_published_at": {"type": ["string", "null"]},
          "revision_policy": {"enum": ["ORIGINAL_VINTAGE", "HISTORICAL_RESTATEMENT_PUBLISHED_BEFORE_CUTOFF", "CURRENT_RESTATED_ONLY"]},
          "admissible": {"type": "boolean"}
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "value", "input_role", "source_ids"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "value": {},
          "input_role": {"enum": ["HISTORICAL_FACT", "JUDGMENT", "MODEL_ASSUMPTION"]},
          "source_ids": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "calibration_ledger": {
      "description": "Frozen material claims for later calibration. This is not a scorecard and cannot contain realized outcomes.",
      "type": "object",
      "required": ["claims"],
      "properties": {
        "claims": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["claim_id", "statement", "materiality", "frozen_disposition", "source_ids", "prediction", "threshold", "unknown", "counter_thesis", "flip_condition", "observable_outcome"],
            "properties": {
              "claim_id": {"type": "string", "pattern": "^HBTCLM:"},
              "statement": {"type": "string", "minLength": 1},
              "materiality": {"enum": ["CENTRAL_THESIS", "VALUATION", "RETURN", "PERMANENT_LOSS"]},
              "frozen_disposition": {"enum": ["PREDICTION", "UNKNOWN"]},
              "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
              "prediction": {
                "type": ["object", "null"],
                "properties": {
                  "metric": {"type": "string", "minLength": 1},
                  "operator": {"enum": ["AT_LEAST", "AT_MOST", "EQUALS", "RANGE"]},
                  "value": {"type": "number"},
                  "range_low": {"type": "number"},
                  "range_high": {"type": "number"},
                  "unit": {"type": "string", "minLength": 1},
                  "horizon": {"type": "string", "minLength": 1}
                }
              },
              "threshold": {
                "type": ["object", "null"],
                "properties": {
                  "metric": {"type": "string", "minLength": 1},
                  "operator": {"enum": ["AT_LEAST", "AT_MOST", "EQUALS"]},
                  "value": {"type": "number"},
                  "unit": {"type": "string", "minLength": 1},
                  "consequence": {"type": "string", "minLength": 1}
                }
              },
              "unknown": {
                "type": ["object", "null"],
                "properties": {
                  "statement": {"type": "string", "minLength": 1},
                  "economic_impact": {"type": "string", "minLength": 1},
                  "resolution_observation": {"type": "string", "minLength": 1}
                }
              },
              "counter_thesis": {"type": "string", "minLength": 1},
              "flip_condition": {"type": "string", "minLength": 1},
              "forward_judgment_id": {"type": "string", "minLength": 1},
              "rival_hypothesis_pair_id": {"type": ["string", "null"], "pattern": "^RHP:"},
              "rival_signal_id": {"type": ["string", "null"], "pattern": "^RHPSIG:"},
              "observable_outcome": {
                "type": "object",
                "required": ["metric", "unit", "measurement_basis", "measurement_rule", "measurement_period", "observation_window", "allowed_source_types", "settlement_version_policy"],
                "properties": {
                  "metric": {"type": "string", "minLength": 1},
                  "unit": {"type": "string", "minLength": 1},
                  "measurement_basis": {"type": "string", "minLength": 1},
                  "measurement_rule": {"type": "string", "minLength": 1},
                  "measurement_period": {
                    "type": "object",
                    "required": ["kind", "start", "end"],
                    "properties": {
                      "kind": {"enum": ["REPORTING_PERIOD", "EVENT_WINDOW"]},
                      "start": {"type": "string", "minLength": 10},
                      "end": {"type": "string", "minLength": 10}
                    }
                  },
                  "observation_window": {
                    "type": "object",
                    "required": ["opens_after", "closes_at"],
                    "properties": {
                      "opens_after": {"type": "string", "minLength": 20},
                      "closes_at": {"type": "string", "minLength": 20}
                    }
                  },
                  "allowed_source_types": {
                    "type": "array",
                    "minItems": 1,
                    "items": {"enum": ["ANNUAL_REPORT", "INTERIM_REPORT", "EXCHANGE_ANNOUNCEMENT", "OTHER_OFFICIAL", "LICENSED_INDUSTRY_DATA"]}
                  },
                  "industry_measurement_inference": {"enum": ["WITHIN_PROVIDER_RELATIVE_CHANGE", "LEVEL_WITH_STATED_LIMITS"]},
                  "licensed_industry_series_contract": {"type": "object", "required": ["pre_cutoff_source_id", "provider_id", "dataset_id", "metric_id", "semantic", "geography", "product_mapping_id", "channel_mapping_id", "brand_mapping_id", "denominator_mapping_id"], "properties": {
                    "pre_cutoff_source_id": {"type": "string", "minLength": 1}, "provider_id": {"type": "string", "minLength": 1}, "dataset_id": {"type": "string", "minLength": 1}, "metric_id": {"type": "string", "minLength": 1}, "semantic": {"type": "string", "minLength": 1}, "geography": {"type": "string", "minLength": 1}, "product_mapping_id": {"type": "string", "minLength": 1}, "channel_mapping_id": {"type": "string", "minLength": 1}, "brand_mapping_id": {"type": "string", "minLength": 1}, "denominator_mapping_id": {"type": "string", "minLength": 1}
                  }},
                  "settlement_version_policy": {"enum": ["INITIAL_DISCLOSURE", "LATEST_OFFICIAL_AS_OF_EVALUATION"]},
                  "metric_reconstruction_contract": {"type": "object", "required": ["source_targets", "prohibited_substitutes", "definition_change_action"], "properties": {
                    "source_targets": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["source_type", "file_scope", "reported_label", "reported_locator"], "properties": {
                      "source_type": {"enum": ["ANNUAL_REPORT", "INTERIM_REPORT", "EXCHANGE_ANNOUNCEMENT", "OTHER_OFFICIAL", "LICENSED_INDUSTRY_DATA"]},
                      "file_scope": {"type": "string", "minLength": 1},
                      "reported_label": {"type": "string", "minLength": 1},
                      "reported_locator": {"type": "string", "minLength": 1}
                    }}},
                    "prohibited_substitutes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
                    "definition_change_action": {"const": "MEASUREMENT_MISMATCH"}
                  }},
                  "conversion_rule": {
                    "type": "object",
                    "required": ["rule_id", "raw_unit", "converted_unit", "multiplier"],
                    "properties": {
                      "rule_id": {"type": "string", "minLength": 1},
                      "raw_unit": {"type": "string", "minLength": 1},
                      "converted_unit": {"type": "string", "minLength": 1},
                      "multiplier": {"type": "number", "exclusiveMinimum": 0}
                    }
                  }
                }
              }
            }
          }
        },
        "rival_hypothesis_pairs": {
          "description": "Frozen primary/rival operating predicates. Verdicts are derived only from later official operating observations.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["pair_id", "competitive_test_id", "primary_mechanism_chain_id", "rival_mechanism_chain_id", "discriminators"],
            "properties": {
              "pair_id": {"type": "string", "pattern": "^RHP:"},
              "competitive_test_id": {"type": "string", "minLength": 1},
              "primary_mechanism_chain_id": {"type": "string", "minLength": 1},
              "rival_mechanism_chain_id": {"type": "string", "minLength": 1},
              "discriminators": {
                "type": "array", "minItems": 2,
                "items": {"type": "object", "required": ["signal_id", "sequence", "stage", "forward_judgment_id", "claim_id", "primary_prediction", "rival_prediction"], "properties": {
                  "signal_id": {"type": "string", "pattern": "^RHPSIG:"},
                  "sequence": {"type": "integer", "minimum": 1},
                  "stage": {"enum": ["EARLY_MECHANISM", "TERMINAL_OPERATING"]},
                  "forward_judgment_id": {"type": "string", "minLength": 1},
                  "claim_id": {"type": "string", "pattern": "^HBTCLM:"},
                  "primary_prediction": {"type": "object"}, "rival_prediction": {"type": "object"}
                }}
              }
            }
          }
        },
        "analogy_transfer_cards": {
          "description": "Frozen structural analogy and near-miss context; it is not a price, probability, or direct valuation input.",
          "type": "array",
          "items": {"type": "object", "required": ["card_id", "target_pair_id"], "properties": {
            "card_id": {"type": "string", "pattern": "^ATC:"},
            "target_pair_id": {"type": "string", "pattern": "^RHP:"}
          }}
        },
        "selection_admission": {
          "description": "Optional frozen R-07 CJO selection-learning receipt. It is not an outcome input; Phase 10 feedback uses it only to classify a settled mechanism signal as selection-eligible or not.",
          "type": "object",
          "required": ["status"],
          "properties": {
            "status": {"enum": ["NOT_SELECTION_ELIGIBLE", "NO_PRIMARY", "SELECTION_ADMITTED"]},
            "candidate_scenario_ids": {"type": "array", "items": {"type": "string"}},
            "strongest_rival_scenario_id": {"type": "string"},
            "strongest_rival_not_selected_reason": {"type": "string"},
            "rival_hypothesis_pair_id": {"type": "string", "pattern": "^RHP:"},
            "no_primary_reason": {"type": "string"},
            "selection_register_binding": {"type": "object", "required": ["register_id", "register_fingerprint", "selection_entry_id", "company_id", "company_cluster_id"], "properties": {
              "register_id": {"type": "string", "pattern": "^CSR:"}, "register_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "selection_entry_id": {"type": "string", "pattern": "^CSRSEL:"}, "company_id": {"type": "string", "minLength": 1}, "company_cluster_id": {"type": "string", "minLength": 1}
            }},
            "gate_receipt": {"type": "object", "required": ["schema_version", "state", "thesis_fingerprint", "selection_status", "selection_forward_judgment_ids"], "properties": {
              "schema_version": {"const": "selection-admission-gate-receipt.v1"}, "state": {"const": "GATE_VALIDATED"},
              "thesis_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "selection_status": {"const": "SELECTION_ADMITTED"},
              "selection_forward_judgment_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}
            }},
            "selection_forward_judgment_ids": {"type": "array", "items": {"type": "string"}},
            "selection_evidence": {
              "type": "array",
              "items": {"type": "object", "required": ["evidence_id", "source_id", "source_group_id", "supports_scenario_id", "directional_reason", "why_rival_cannot_equally_explain", "distortion_downgrade"], "properties": {
                "evidence_id": {"type": "string"}, "source_id": {"type": "string"},
                "source_group_id": {"type": "string"}, "supports_scenario_id": {"type": "string"},
                "directional_reason": {"type": "string"},
                "why_rival_cannot_equally_explain": {"type": "string"},
                "distortion_downgrade": {"type": "string"}
              }}
            },
            "selection_evidence_bundles": {
              "description": "Optional multi-layer pre-cutoff selection receipt. A bundle must independently bind its components to a shared early discriminator; it does not turn common facts into directional evidence.",
              "type": "array",
              "items": {"type": "object", "required": ["bundle_id", "supports_scenario_id", "forward_judgment_id", "leading_threshold_id", "joint_directional_reason", "joint_rival_exclusion_reason", "joint_distortion_downgrade", "components"], "properties": {
                "bundle_id": {"type": "string"}, "supports_scenario_id": {"type": "string"},
                "forward_judgment_id": {"type": "string"}, "leading_threshold_id": {"type": "string"},
                "joint_directional_reason": {"type": "string"}, "joint_rival_exclusion_reason": {"type": "string"},
                "joint_distortion_downgrade": {"type": "string"},
                "components": {"type": "array", "minItems": 2, "items": {"type": "object", "required": ["evidence_id", "source_id", "source_group_id", "component_role", "forward_judgment_id", "primary_causal_edge_id"], "properties": {
                  "evidence_id": {"type": "string"}, "source_id": {"type": "string"}, "source_group_id": {"type": "string"},
                  "component_role": {"enum": ["DECISION_IMPLEMENTATION", "CUSTOMER_OR_COMPETITOR_RESPONSE", "UNIT_ECONOMICS", "WORKING_CAPITAL_OR_CASH", "CAPITAL_RETURN"]},
                  "forward_judgment_id": {"type": "string"},
                  "primary_causal_edge_id": {"type": "string"}
                }}}
              }}
            }
          }
        }
      }
    },
    "taxes_fees_fx": {
      "type": "object",
      "required": ["tax_rate", "transaction_fee_rate", "dividend_tax_rate", "base_currency", "fx_rule"],
      "properties": {
        "tax_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "transaction_fee_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "dividend_tax_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "base_currency": {"type": "string", "minLength": 3},
        "fx_rule": {"type": "string", "minLength": 1}
      }
    },
    "price_identity": {
      "type": "object",
      "required": ["primary_route", "primary_price_identity", "prices"],
      "properties": {
        "primary_route": {"enum": ["LONG_TERM_OWNER", "FINITE_XIRR", "DUAL", "PRIMARY_ROUTE_UNKNOWN"]},
        "primary_price_identity": {"enum": ["P_LONG", "P_XIRR", "P_LEGAL", "P_BUSINESS_VALUE_EXIT", "UNKNOWN"]},
        "prices": {"type": "array", "items": {"type": "object", "required": ["identity", "currency", "value", "meaning"], "properties": {"identity": {"type": "string"}, "currency": {"type": "string"}, "value": {"type": "number"}, "meaning": {"type": "string"}}}}
      }
    },
    "investment_decision": {
      "description": "Action and execution rule frozen with the report; optional for legacy calibration-only cases.",
      "type": "object",
      "required": ["action", "price_identity", "execution_rule"],
      "properties": {
        "action": {"enum": ["BUY", "HOLD", "WAIT", "SELL", "NO_BUY", "UNKNOWN"]},
        "price_identity": {"enum": ["P_LONG", "P_XIRR", "P_LEGAL", "P_BUSINESS_VALUE_EXIT", "UNKNOWN"]},
        "execution_rule": {"type": "string", "minLength": 1}
      }
    },
    "status": {"enum": ["FROZEN", "FROZEN_WITH_QUALITY_FAILURE", "INVALID"]}
  },
  "$defs": {
    "actor_provenance": {
      "type": "object",
      "required": ["actor_type", "context_id"],
      "properties": {
        "actor_type": {"enum": ["human", "model", "hybrid"]},
        "provider": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "context_id": {"type": "string", "minLength": 1}
      }
    },
    "reviewer_independence": {
      "type": "object",
      "required": ["did_not_generate_candidate", "no_prior_review_seen", "reviewer_context_isolated", "generator_identity_disjoint"],
      "properties": {
