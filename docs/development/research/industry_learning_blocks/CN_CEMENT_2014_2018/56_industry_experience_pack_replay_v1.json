  "settlement_plan": {
    "industry_claims": [
      {
        "claim_id": "IEP:CEMENT:INDUSTRY_REGIME_AND_PROFIT_POOL",
        "claim": "需求、供给约束、区域价格和利用率如何改变 2018 年后水泥利润池。",
        "measurement_sources": [
          "国家统计局或工信部水泥产量与投资序列",
          "中国水泥协会产能、错峰与区域价格资料",
          "至少四类公司同口径销量、价格、成本和利用率结果"
        ],
        "unresolved_treatment": "行业方向保持未结算；仅保留区域市场、资本强度和公司边界的研究框架。"
      }
    ],
    "company_transmission_claims": [
      {
        "claim_id": "IEP:CEMENT:COMPANY_DIVERGENCE",
        "claim": "区域组合、成本位置、并购重组和资本强度是否导致公司在同一行业变化下出现不同正常盈利与现金路径。",
        "measurement_sources": [
          "同责任边界的公司销量、价格、成本、经营现金和资本开支",
          "重组、并购、合资和控制权变化的官方 perimeter bridge"
        ],
        "unresolved_treatment": "只结算具备同边界结果的公司路径，不用单家公司替代行业结果。"
      }
    ]
