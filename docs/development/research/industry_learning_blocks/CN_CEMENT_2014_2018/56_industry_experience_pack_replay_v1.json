  "current_synthesis": {
    "central_industry_path": "截至 2018-04-30，现有多公司材料足以判断中国水泥是区域 delivered-market、资本密集且公司边界差异显著的行业；但缺少同 cutoff 的官方需求、供给、价格、成本与产能利用率序列，不能判断未来利润池方向。",
    "strongest_rival": "供给侧约束、行业整合和区域集中可能已经改善价格纪律与利润池，现有 block 只是因采集偏重公司边界而没有观察到该方向，而非行业方向本身不可判断。",
    "profit_pool_transmission": "待补证路径为需求与供给约束先改变区域价格和产能利用率，再通过公司区域组合、成本位置、资本强度和边界连续性传导到正常盈利与 owner cash；当前只能确认传导框架，不能确认方向。",
    "scope_conditions": [
      "以区域 delivered market 而不是注册地或全国总量定义竞争范围。",
      "公司比较必须保持相同责任边界并保留重组、并购和合资造成的 perimeter break。",
      "同行事实只建立行业 reference class，不能建立海螺或其他目标公司的现金事实。"
    ],
    "break_conditions": [
      "官方行业序列显示供给、需求、价格或利用率与公司年报叙事方向相反。",
      "区域组合和运输半径使同一全国行业变量无法解释公司的实际 delivered-market 利润池。",
      "重组、并购或控制权变化破坏公司跨期经营和现金口径。"
    ],
